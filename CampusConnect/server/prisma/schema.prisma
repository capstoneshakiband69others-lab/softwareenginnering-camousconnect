generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  CLUB_EXECUTIVE
  FACULTY_ADVISOR
  ADMIN
}
enum UserStatus {
  ACTIVE
  DISABLED
}
enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  LEFT
}
enum EventStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  PUBLISHED
  CANCELLED
  COMPLETED
}
enum RegistrationStatus {
  ACTIVE
  CANCELLED
}
enum AttendanceStatus {
  PRESENT
  ABSENT
}
enum AttendanceMethod {
  QR
  MANUAL
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String
  role           Role            @default(STUDENT)
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  studentProfile StudentProfile?
  memberships    ClubMember[]
  registrations  Registration[]
  managedClubs   Club[]          @relation("ClubExecutives")
  advisedClubs   Club[]          @relation("ClubAdvisor")
  announcements  Announcement[]
  notifications  Notification[]
  approvalLogs   ApprovalLog[]
  feedback       Feedback[]
}
model StudentProfile {
  id             String @id @default(cuid())
  userId         String @unique
  studentNumber  String? @unique
  department     String?
  batch          String?
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model EventCategory {
  id          String @id @default(cuid())
  name        String @unique
  description String?
  events      Event[]
}
model Club {
  id          String @id @default(cuid())
  name        String @unique
  description String
  status      String @default("ACTIVE")
  categoryId  String?
  createdAt   DateTime @default(now())
  executives  User[] @relation("ClubExecutives")
  advisor     User? @relation("ClubAdvisor", fields: [advisorId], references: [id])
  advisorId   String?
  memberships ClubMember[]
  events      Event[]
  announcements Announcement[]
}
model ClubMember {
  id         String @id @default(cuid())
  clubId     String
  userId     String
  status     MembershipStatus @default(PENDING)
  requestedAt DateTime @default(now())
  decidedAt  DateTime?
  decidedBy  String?
  club       Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([clubId, userId])
}
model Event {
  id           String @id @default(cuid())
  clubId       String
  categoryId   String?
  title        String
  description  String
  startAt      DateTime
  endAt        DateTime
  venue        String
  capacity     Int
  deadline     DateTime
  status       EventStatus @default(DRAFT)
  decisionNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  club         Club @relation(fields: [clubId], references: [id])
  category     EventCategory? @relation(fields: [categoryId], references: [id])
  registrations Registration[]
  announcements Announcement[]
  approvalLogs ApprovalLog[]
  feedback     Feedback[]
}
model Registration {
  id           String @id @default(cuid())
  eventId      String
  userId       String
  status       RegistrationStatus @default(ACTIVE)
  registeredAt DateTime @default(now())
  qrToken      String @unique
  event        Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance   Attendance?
  certificate  Certificate?
  @@unique([eventId, userId])
}
model Attendance {
  id             String @id @default(cuid())
  registrationId String @unique
  status         AttendanceStatus @default(PRESENT)
  markedAt       DateTime @default(now())
  markedBy       String
  method         AttendanceMethod @default(MANUAL)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}
model Certificate {
  id             String @id @default(cuid())
  registrationId String @unique
  certificateCode String @unique
  issuedAt       DateTime @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}
model Announcement {
  id          String @id @default(cuid())
  clubId      String?
  eventId     String?
  authorId    String
  title       String
  body        String
  publishedAt DateTime @default(now())
  club        Club? @relation(fields: [clubId], references: [id], onDelete: SetNull)
  event       Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  author      User @relation(fields: [authorId], references: [id])
}
model Notification {
  id        String @id @default(cuid())
  userId    String
  type      String
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Feedback {
  id        String @id @default(cuid())
  eventId   String
  userId    String
  rating    Int
  comments  String?
  createdAt DateTime @default(now())
  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId])
}
model ApprovalLog {
  id        String @id @default(cuid())
  eventId   String
  actorId   String
  decision  String
  note      String?
  createdAt DateTime @default(now())
  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor     User @relation(fields: [actorId], references: [id])
}
